# Config de production (valeurs NON secrètes — le secret AUTH_SECRET est
# généré et conservé automatiquement par server.js).
NEXT_PUBLIC_SITE_URL=https://www.trevys.fr
NEXTAUTH_URL=https://www.trevys.fr
# Base PostgreSQL locale de l'instance Gandi (accessible seulement en interne).
DATABASE_URL=postgresql://hosting-db@localhost:5432/postgres?schema=public
