# ─────────────────────────────────────────────────────────────
# Site public Trevys — variables d'environnement
# Copiez ce fichier en `.env` (ou configurez-les chez votre hébergeur).
# Tant qu'elles ne sont pas définies, le site fonctionne :
#  - sans Turnstile : le formulaire reste protégé par honeypot + délai
#  - sans SMTP : les messages de contact sont journalisés (non envoyés)
# ─────────────────────────────────────────────────────────────

# ── Obligatoire ──────────────────────────────────────────────
# Secret d'authentification (générer : openssl rand -base64 32)
AUTH_SECRET=

# Base de données PostgreSQL.
#  • Pour visualiser UNIQUEMENT le site vitrine en local, une URL factice
#    suffit (le site public ne requête pas la base) :
#    postgresql://user:pass@localhost:5432/db?schema=public
#  • Pour utiliser le back-office /admin (connexion), mettez l'URL d'une
#    vraie base PostgreSQL puis lancez les migrations + le seed.
DATABASE_URL=

# Anti-bot Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Envoi des e-mails de contact (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Site Trevys <contact@trevys-advisory.fr>"
CONTACT_TO=contact@trevys-advisory.fr

# Prise de rendez-vous Calendly (URL de l'événement à intégrer)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/trevys-advisory/15min

# Newsletter Brevo (https://app.brevo.com → SMTP & API → clés API)
# Créez une liste "Newsletter site" et renseignez son ID.
BREVO_API_KEY=
BREVO_LIST_ID=
